generator client {
  provider = "prisma-client"
  output   = "../generated/prisma-app"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  USER
}

model User {
  id          String           @id @default(cuid())
  googleSub   String?          @unique
  email       String           @unique
  name        String?
  avatarUrl   String?
  status      UserStatus       @default(PENDING)
  role        UserRole         @default(USER)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  permissions  UserPermission[]
  aiAnalyses   UserAiAnalysis[]
  aiCompares   UserAiCompare[]
}

model UserPermission {
  userId        String
  permissionKey String
  granted       Boolean @default(false)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionKey])
}

model LibraryDocument {
  slug      String   @id
  content   Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  updatedBy String?
}

model LibraryPending {
  id             String   @id
  type           String
  label          String
  detailVi       String
  jsonSuggestion Json
  appId          Int
  gameName       String
  status         String   @default("pending")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
}

model RubricManifest {
  id        Int      @id @default(1)
  content   Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

/// AI review analysis results (shared read; row still tied to user who ran it).
model UserAiAnalysis {
  id         String   @id @default(cuid())
  userId     String
  appId      Int
  analyzedAt DateTime @db.Timestamptz(6)
  payload    Json
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appId, analyzedAt])
  @@index([userId])
  @@index([userId, appId])
  @@index([appId, analyzedAt(sort: Desc)])
}

/// Kết quả so sánh AI nhiều game (theo bộ appIds).
model UserAiCompare {
  id         String   @id @default(cuid())
  userId     String
  appIdsKey  String
  appIds     Json
  comparedAt DateTime @db.Timestamptz(6)
  payload    Json
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([appIdsKey, comparedAt(sort: Desc)])
  @@index([userId])
}

/// Snapshot top 20 mỗi bảng Potential (14 ngày, combined) theo ngày ICT.
model PotentialBoardDay {
  date  DateTime @db.Date
  /// reserve_growth | reserve_scale | launch_growth | launch_scale
  board String
  rank  Int
  appId Int
  title String
  score Float

  @@id([date, board, rank])
  @@index([date, board])
  @@index([board, appId])
}

/// Một lần job alert / baseline trong ngày — cron chạy lại không phân tích/gửi trùng.
model PotentialAlertRun {
  date          DateTime @id @db.Date
  status        String
  newCount      Int      @default(0)
  analyzedCount Int      @default(0)
  payload       Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
}

/// Một kỳ Game Radar Recap (ngày ICT).
model RadarRecapRun {
  date       DateTime        @id @db.Date
  status     String
  periodCode String
  summary    Json?
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(6)
  rows       RadarRecapRow[]
}

/// Một dòng top 20 trong kỳ Radar (Reserve growth/scale hoặc New Launch).
model RadarRecapRow {
  id          String        @id @default(cuid())
  date        DateTime      @db.Date
  board       String
  rank        Int
  appId       Int
  title       String
  titleEn     String?
  score       Float
  nextAction  String
  insights    String
  adjustments String
  screening   String
  payload     Json
  run         RadarRecapRun @relation(fields: [date], references: [date], onDelete: Cascade)

  @@unique([date, board, rank])
  @@index([date, board])
  @@index([appId, date])
}
