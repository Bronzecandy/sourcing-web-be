generator client {
  provider = "prisma-client"
  output   = "../generated/prisma-app"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  USER
  TESTER
}

model User {
  id          String           @id @default(cuid())
  googleSub   String?          @unique
  email       String           @unique
  name        String?
  avatarUrl   String?
  status      UserStatus       @default(PENDING)
  /// Nhiều role: tối đa 1 role Sourcing (SUPER_ADMIN | ADMIN | STAFF | USER) cộng TESTER.
  roles       UserRole[]       @default([USER])
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  permissions  UserPermission[]
  aiAnalyses   UserAiAnalysis[]
  aiCompares   UserAiCompare[]
  surveyResponses    SurveyResponse[]
  testerProfile      TesterProfile?
  testAssignments    TestAssignment[]
  benefitRedemptions BenefitRedemption[]
}

model UserPermission {
  userId        String
  permissionKey String
  granted       Boolean @default(false)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionKey])
}

model LibraryDocument {
  slug      String   @id
  content   Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  updatedBy String?
}

model LibraryPending {
  id             String   @id
  type           String
  label          String
  detailVi       String
  jsonSuggestion Json
  appId          Int
  gameName       String
  status         String   @default("pending")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
}

model RubricManifest {
  id        Int      @id @default(1)
  content   Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

/// AI review analysis results (shared read; row still tied to user who ran it).
model UserAiAnalysis {
  id         String   @id @default(cuid())
  userId     String
  appId      Int
  analyzedAt DateTime @db.Timestamptz(6)
  payload    Json
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appId, analyzedAt])
  @@index([userId])
  @@index([userId, appId])
  @@index([appId, analyzedAt(sort: Desc)])
}

/// Kết quả so sánh AI nhiều game (theo bộ appIds).
model UserAiCompare {
  id         String   @id @default(cuid())
  userId     String
  appIdsKey  String
  appIds     Json
  comparedAt DateTime @db.Timestamptz(6)
  payload    Json
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([appIdsKey, comparedAt(sort: Desc)])
  @@index([userId])
}

/// Snapshot top 20 mỗi bảng Potential (14 ngày, combined) theo ngày ICT.
model PotentialBoardDay {
  date  DateTime @db.Date
  /// reserve_growth | reserve_scale | launch_growth | launch_scale
  board String
  rank  Int
  appId Int
  title String
  score Float

  @@id([date, board, rank])
  @@index([date, board])
  @@index([board, appId])
}

/// Một lần job alert / baseline trong ngày — cron chạy lại không phân tích/gửi trùng.
model PotentialAlertRun {
  date          DateTime @id @db.Date
  status        String
  newCount      Int      @default(0)
  analyzedCount Int      @default(0)
  payload       Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
}

/// Một kỳ Game Radar Recap (ngày ICT).
model RadarRecapRun {
  date       DateTime        @id @db.Date
  status     String
  periodCode String
  summary    Json?
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(6)
  rows       RadarRecapRow[]
}

/// Một dòng top 20 trong kỳ Radar (Reserve growth/scale hoặc New Launch).
model RadarRecapRow {
  id          String        @id @default(cuid())
  date        DateTime      @db.Date
  board       String
  rank        Int
  appId       Int
  title       String
  titleEn     String?
  score       Float
  nextAction  String
  insights    String
  adjustments String
  screening   String
  payload     Json
  run         RadarRecapRun @relation(fields: [date], references: [date], onDelete: Cascade)

  @@unique([date, board, rank])
  @@index([date, board])
  @@index([appId, date])
}

/// Bảng hỏi Tester Program (cấu hình theo format survey-toolkit, seed từ tab Questionnaire).
model SurveyForm {
  id           String           @id @default(cuid())
  slug         String           @unique
  version      Int              @default(1)
  title        String
  introduction String
  supplement   String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)
  questions    SurveyQuestion[]
  responses    SurveyResponse[]
}

model SurveyQuestion {
  id          String         @id @default(cuid())
  formId      String
  /// Cột c trong file cấu hình.
  number      Int
  code        String
  text        String
  /// text_single | text_multiple | text_num | single | multiple | matrixs
  type        String
  mustAnswer  Boolean        @default(true)
  page        Int            @default(1)
  pic         String?
  video       String?
  regex       String?
  /// name | office | team | age | platforms | gender | weekly_play | genres | genre_detail | other_games | favorite_genre | pay | test_time
  semanticKey String?
  genreKey    String?
  form        SurveyForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  options     SurveyOption[]

  @@unique([formId, number])
}

model SurveyOption {
  id         String         @id @default(cuid())
  questionId String
  order      Int
  label      String
  value      String
  jump       Int?
  connect    Int[]
  fix        Boolean        @default(true)
  exclusive  Boolean        @default(false)
  textInput  Boolean        @default(false)
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
}

/// Mỗi lần nộp bảng hỏi (giữ lịch sử; bản mới nhất dựng TesterProfile).
model SurveyResponse {
  id          String     @id @default(cuid())
  formId      String
  formVersion Int
  userId      String
  answers     Json
  startedAt   DateTime?  @db.Timestamptz(6)
  submittedAt DateTime   @default(now()) @db.Timestamptz(6)
  durationSec Int?
  device      String?
  /// web | sheet-import
  source      String     @default("web")
  form        SurveyForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt(sort: Desc)])
}

model TesterProfile {
  userId          String             @id
  name            String
  office          String?
  team            String?
  ageRange        String?
  /// MB | PC | CS
  platforms       String[]
  gender          String?
  weeklyPlayLabel String?
  weeklyPlayLevel Int?
  payLabel        String?
  payTier         String?
  testTimeLabel   String?
  favoriteGenre   String?
  genres          String[]
  /// in_team | staff | collab — lọc theo mức bảo mật game test (trống = staff)
  testerType      String?
  active          Boolean            @default(true)
  /// pending | scoring | scored | failed
  scoringStatus   String             @default("pending")
  scoredAt        DateTime?          @db.Timestamptz(6)
  responseId      String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  genreScores     TesterGenreScore[]
}

/// Điểm hardcore 0–100 theo dòng game (volume + rank, port từ Hardcore Score.gs).
model TesterGenreScore {
  userId       String
  genre        String
  rawText      String
  rawHash      String
  volumeScore  Int
  rankScore    Int
  hasRank      Boolean
  hours        Int
  matches      Int
  anchorGame   String?
  bestRank     String?
  matchedGames Json
  finalScore   Int
  /// ai | sheet
  source       String        @default("ai")
  model        String?
  scoredAt     DateTime      @default(now()) @db.Timestamptz(6)
  profile      TesterProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, genre])
  @@index([genre, finalScore])
}

/// Thư viện game dùng khi chấm hardcore (tên/alias → genre); AI bổ sung game mới.
model GameLibraryEntry {
  id            String   @id @default(cuid())
  canonicalName String   @unique
  aliases       String[]
  genres        String[]
  subgenres     String[]
  /// seed | sheet | ai_classified | manual
  source        String
  confidence    Int
  notes         String?
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
}

/// Cache kết quả chấm theo hash(genre|raw) — cùng câu trả lời không gọi AI lại.
model TesterScoreCache {
  key       String   @id
  result    Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

/// Game test (module Test Game); appId gắn TapTap để Radar đọc tình trạng test nội bộ.
model TestCampaign {
  id               String           @id @default(cuid())
  gameName         String
  /// Tên gốc CN/KR
  originalName     String?
  testRound        Int              @default(1)
  /// Game test trước của cùng game (tạo lại → Lần test +1)
  previousId       String?
  appId            Int?
  iconUrl          String?
  /// Thể loại mô tả tự do
  genre            String?
  /// MB | PC | CS (suy từ platforms, dùng lọc tester)
  platform         String?
  /// Android | iOS | PC | Console
  platforms        String[]         @default([])
  mainTags         String[]
  secondaryTags    String[]
  developer        String?
  ipName           String?
  devStage         String?
  taptapUrl        String?
  googlePlayUrl    String?
  steamUrl         String?
  background       String?
  /// regional_bd | vn_new_game | local_team
  source           String?
  requester        String?
  sourceDetail     String?
  /// confidential | high | normal
  securityLevel    String           @default("normal")
  noTest           Boolean          @default(false)
  templateId       String?
  /// Bản template chốt lúc Initiate (câu hỏi, tag, trọng số)
  templateSnapshot Json?
  /// self_play | daily | focused | video
  evalFormat       String?
  hoursPerDay      Float?
  testDays         Int?
  focusedAt        DateTime?        @db.Timestamptz(6)
  focusedPlace     String?
  guide            String?
  /// Link cài đặt ngoài folder Drive (TestFlight, store, bản web...)
  installUrl       String?
  /// Ghi chú cho tester: nội dung cần test cụ thể
  testerNote       String?
  /// Steam key, tài khoản test — chỉ Admin xem, chèn vào M3
  accessInfo       String?
  footageRequired  Boolean          @default(false)
  apkFolderId      String?
  apkFolderUrl     String?
  apkFolderError   String?
  /// Tiến độ in-game kỳ vọng theo số giờ test (AI web search, dùng duyệt bằng chứng)
  progressResearch Json?
  workloadHours    Float            @default(0)
  coordinatorName  String?
  coordinatorEmail String?
  startDate        DateTime?        @db.Date
  endDate          DateTime?        @db.Date
  reportDeadline   DateTime?        @db.Date
  team             String?
  /// pending | inviting | testing | reporting | done | cancelled
  status           String           @default("pending")
  initiatedAt      DateTime?        @db.Timestamptz(6)
  initiatedBy      String?
  /// sent | failed | skipped
  seatalkStatus    String?
  seatalkError     String?
  /// suitable | unsuitable — Radar đọc (drop → unsuitable)
  result           String?
  resultNote       String?
  conclusion       String?
  /// drop | monitor | recommend
  decision         String?
  legacyReportUrl  String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  assignments      TestAssignment[]
  files            TestFile[]
  mailLogs         TestMailLog[]
  report           TestReport?
  reportRuns       TestReportRun[]
  shareKeys        TestShareKey[]
  auditLogs        TestAuditLog[]

  @@index([appId])
  @@index([status, startDate])
  @@index([gameName])
}

/// Dòng gán tester (định danh bằng email) trong một game test.
model TestAssignment {
  id            String       @id @default(cuid())
  campaignId    String
  email         String
  userId        String?
  /// added | invited | confirmed | declined | no_response | in_test | submitted
  status        String       @default("added")
  invitedAt     DateTime?    @db.Timestamptz(6)
  respondedAt   DateTime?    @db.Timestamptz(6)
  submittedAt   DateTime?    @db.Timestamptz(6)
  /// Câu trả lời questionnaire { [questionId]: value }
  answers       Json?
  /// Lần lưu câu trả lời gần nhất (nháp hoặc nộp)
  answersUpdatedAt DateTime? @db.Timestamptz(6)
  workloadHours Float?
  /// Admin đã duyệt hoàn thành → tính giờ + benefit
  completed     Boolean      @default(false)
  completedAt   DateTime?    @db.Timestamptz(6)
  /// pending | approved | rejected
  reviewStatus  String?
  reviewNote    String?
  reviewedBy    String?
  reviewedAt    DateTime?    @db.Timestamptz(6)
  /// queued | running | done | failed
  aiStatus      String?
  aiReview      Json?
  aiReviewAt    DateTime?    @db.Timestamptz(6)
  whitelistInfo String?
  /// ok | lỗi cấp quyền xem folder APK
  driveShare    String?
  note          String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  campaign      TestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  files         TestFile[]
  mailLogs      TestMailLog[]

  @@unique([campaignId, email])
  @@index([userId])
  @@index([email])
  @@index([reviewStatus])
}

/// Tệp của game test: guide (tệp hướng dẫn), footage, evidence (ảnh UID/level).
model TestFile {
  id           String          @id @default(cuid())
  campaignId   String
  assignmentId String?
  /// guide | footage | evidence
  kind         String
  fileName     String
  mime         String
  size         Int
  storagePath  String
  sha256       String
  /// dHash 64-bit (hex) cho ảnh — dò ảnh trùng / gần trùng
  dhash        String?
  width        Int?
  height       Int?
  uploadedBy   String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  campaign     TestCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignment   TestAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([campaignId, kind])
  @@index([assignmentId])
  @@index([sha256])
  @@index([kind, dhash])
}

/// Mẫu mail M1–M7 (Admin sửa, bật/tắt).
model TestMailTemplate {
  code      String   @id
  name      String
  subject   String
  body      String
  enabled   Boolean  @default(true)
  version   Int      @default(1)
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// Nhật ký gửi mail: mỗi mốc gửi tối đa một lần cho mỗi tester.
model TestMailLog {
  id           String          @id @default(cuid())
  campaignId   String
  assignmentId String?
  code         String
  toEmail      String
  subject      String?
  /// queued (đã giao bot, chờ kết quả) | sent | failed
  status       String
  error        String?
  attempts     Int             @default(1)
  /// auto | manual | test
  trigger      String          @default("auto")
  sentAt       DateTime        @default(now()) @db.Timestamptz(6)
  campaign     TestCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignment   TestAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([campaignId, code])
  @@index([assignmentId, code])
}

/// Việc giao bot Apps Script (testgame@garena.vn) qua trạm trung chuyển trên VM data; kết quả về thì áp vào bản ghi trong context.
model TestBotJob {
  id         String    @id @default(cuid())
  /// sendMail | createFolder | shareFolder
  action     String
  campaignId String?
  /// { kind: "mail", mailLogId } | { kind: "folder" } | { kind: "share", assignmentIds }
  context    Json
  /// queued | done | failed
  status     String    @default("queued")
  error      String?
  result     Json?
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([campaignId, action, status])
}

/// Tag dùng chung cho mọi template (mỗi tag có điểm = một section report).
model TestTag {
  name        String   @id
  scored      Boolean  @default(true)
  description String   @default("")
  sortOrder   Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// Template questionnaire theo dòng game; Khung cơ bản có isBase = true.
model TestQuestionTemplate {
  id         String   @id @default(cuid())
  name       String
  genres     String[] @default([])
  isBase     Boolean  @default(false)
  /// draft | active | retired
  status     String   @default("draft")
  version    Int      @default(1)
  /// [{ id, code, text, help, type, role, tag, key, required, options, scaleMin, scaleMax, minLabel, maxLabel }]
  questions  Json
  /// { [tag]: weight }
  tagWeights Json     @default("{}")
  updatedBy  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
}

/// Report của game test (nội dung Admin đã Lưu; điểm tính lúc đọc).
model TestReport {
  campaignId    String       @id
  /// updating | locked
  status        String       @default("updating")
  /// { [tag]: { vi: string, en: string } }
  sections      Json         @default("{}")
  usp           String?
  pros          String?
  cons          String?
  conclusion    String?
  decision      String?
  /// Kết quả AI-03 (cấu hình yêu cầu + nguồn)
  configRequirement Json?
  /// { overall, byPlatform, method: library | ai | unknown }
  configLevel   Json?
  configUpdatedAt DateTime?  @db.Timestamptz(6)
  lockedAt      DateTime?    @db.Timestamptz(6)
  lockedBy      String?
  updatedBy     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)
  campaign      TestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

/// Lịch sử các lần "Tổng hợp" (AI-01 → AI-05 → AI-02) và "Cập nhật cấu hình" (AI-03/04).
model TestReportRun {
  id         String       @id @default(cuid())
  campaignId String
  /// summary | config
  kind       String
  /// running | done | failed
  status     String       @default("running")
  output     Json?
  error      String?
  nSubmitted Int          @default(0)
  createdBy  String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  finishedAt DateTime?    @db.Timestamptz(6)
  savedAt    DateTime?    @db.Timestamptz(6)
  savedBy    String?
  campaign   TestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, kind, createdAt])
}

/// Key chia sẻ report (chỉ đọc).
model TestShareKey {
  id         String       @id @default(cuid())
  campaignId String
  key        String       @unique
  label      String?
  expiresAt  DateTime?    @db.Timestamptz(6)
  revokedAt  DateTime?    @db.Timestamptz(6)
  createdBy  String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  campaign   TestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

/// Nhật ký thao tác module Test Game.
model TestAuditLog {
  id         String        @id @default(cuid())
  campaignId String?
  actor      String?
  action     String
  detail     Json?
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  campaign   TestCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

/// Cấu hình chung module Test Game (key → JSON).
model TestGameSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// Lượt đổi quà bằng benefit (benefit có = round(giờ test hoàn thành / 3)). Tester tự gửi yêu cầu, PIC trao quà.
model BenefitRedemption {
  id          String    @id @default(cuid())
  userId      String
  amount      Int
  item        String
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  /// pending (chờ trao) | fulfilled (đã trao) | rejected | cancelled — pending + fulfilled trừ vào benefit
  status      String    @default("fulfilled")
  /// Vị trí tier/phần quà trong benefits.json lúc đổi
  tier        Int?
  game        String?
  reward      String?
  /// Tài khoản nhận quà tester nhập (UID, tên nhân vật, server…)
  gameAccount String?
  adminNote   String?
  processedBy String?
  processedAt DateTime? @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
}

/// Snapshot TapTap hằng ngày của game trong 3 bảng Radar — so lịch ra mắt/test giữa 2 kỳ.
model RadarGameSnapshot {
  date          DateTime @db.Date
  appId         Int
  title         String
  reserveCount  Int?
  downloadCount Int?
  rating        String?
  flag          Int?
  releaseDate   String?
  scheduleKind  String?
  scheduleDate  String?
  scheduleLabel String?
  facts         Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@id([date, appId])
  @@index([appId, date])
}

/// TapTap appId → Sensor Tower unified app / Steam app. status: auto | confirmed | none | unmapped.
model GameMarketMapping {
  appId        Int       @id
  title        String
  stStatus     String    @default("unmapped")
  stUnifiedId  String?
  stName       String?
  stMethod     String?
  stRef        Json?
  steamStatus  String    @default("unmapped")
  steamAppId   Int?
  steamName    String?
  steamMethod  String?
  steamRef     Json?
  /// Web-searched international names, developer/publisher (EN), Steam URL.
  identity     Json?
  identityAt   DateTime? @db.Timestamptz(6)
  checkedAt    DateTime  @default(now()) @db.Timestamptz(6)
  confirmedBy  String?
  confirmedAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  @@index([stUnifiedId])
  @@index([steamAppId])
}

/// status: queued | running | needs_mapping | done | failed.
model DeepResearchRun {
  id            String    @id @default(cuid())
  appId         Int
  title         String
  iconUrl       String?
  status        String    @default("queued")
  stage         String?
  stages        Json?
  context       Json?
  createdById   String?
  createdByName String?
  taptap        Json?
  mapping       Json?
  candidates    Json?
  market        Json?
  steam         Json?
  web           Json?
  summary       Json?
  verdict       String?
  marketScore   Float?
  error         String?
  startedAt     DateTime? @db.Timestamptz(6)
  finishedAt    DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  @@index([appId, createdAt])
  @@index([createdAt])
}
